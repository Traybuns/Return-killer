{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReturnKillerBedrockInvoke",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:*::foundation-model/amazon.nova-2-lite-v1:0",
        "arn:aws:bedrock:*:*:inference-profile/us.amazon.nova-2-lite-v1:0",
        "arn:aws:bedrock:*:*:inference-profile/global.amazon.nova-2-lite-v1:0"
      ]
    },
    {
      "Sid": "ReturnKillerWebGrounding",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeTool"
      ],
      "Resource": [
        "arn:aws:bedrock::*:system-tool/amazon.nova_grounding"
      ]
    }
  ]
}
